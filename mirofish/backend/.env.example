# Mirofish AI - Environment Configuration
# Copy this file to .env and adjust values

# Application
APP_NAME=Mirofish AI
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8080

# Database (SQLite - lightweight)
DATABASE_URL=sqlite+aiosqlite:///./database/mirofish.db
DATABASE_ECHO=false

# MQTT Broker (Mosquitto - lightweight)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=mirofish
MQTT_PASSWORD=mirofish123
MQTT_KEEPALIVE=60

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/ML Models
# Path ke model AI Kuera yang sudah ada
MODEL_PATH=../models
USE_LOCAL_LLM=true
LLM_MODEL_PATH=../models/llm

# Simulation
SIMULATION_ENABLED=true
SIMULATION_INTERVAL=5
SENSOR_DATA_INTERVAL=10

# Alert Thresholds
PH_MIN=6.5
PH_MAX=8.5
DO_MIN=4.0
TEMP_MIN=24.0
TEMP_MAX=30.0
AMMONIA_MAX=0.1

# External APIs (Gratis/Trial)
# OpenWeatherMap API (gratis tier)
WEATHER_API_KEY=your-openweather-api-key

# Integration dengan AI Kuera
KUERA_API_URL=http://localhost:8000
KUERA_INTEGRATION_ENABLED=true
