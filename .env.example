# AI Kuera + Mirofish Environment
# Database
DATABASE_URL=sqlite:///data/databases/kuera.db
MEMORY_URL=sqlite:///data/databases/memory.db

# API/Web
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Models
MODELS_PATH=./models
LLM_PATH=./models/llm

# Features
ENABLE_EVOLUTION=true
ENABLE_MIROFISH=true
LOG_LEVEL=INFO

# Cloud Model API (optional — for complex reasoning tasks)
# Kimi, OpenRouter, or any OpenAI-compatible API
KUERA_CLOUD_API_KEY=your-api-key-here
KUERA_CLOUD_BASE_URL=https://api.moonshot.cn/v1
KUERA_CLOUD_MODEL=kimi-k2-5

# Security
SECRET_KEY=your-secret-key-change-me
JWT_ALGO=HS256

